{
  "name": "@twigeducation/videojs-analytics",
  "version": "1.0.0",
  "description": "Track Google Analytics events from video.js players",
  "main": "cjs/plugin.js",
  "module": "es/plugin.js",
  "browser": "dist/videojs-analytics.js",
  "generator-videojs-plugin": {
    "version": "8.0.0"
  },
  "homepage": "https://github.com/TwigWorld/videojs-analytics",
  "repository": {
    "type": "git",
    "url": "https://github.com/TwigWorld/videojs-analytics.git"
  },
  "bugs": {
    "url": "https://github.com/TwigWorld/videojs-analytics/issues"
  },
  "scripts": {
    "build": "npm-run-all -s clean -p build:*",
    "build-prod": "cross-env-shell NO_TEST_BUNDLE=1 'npm run build'",
    "build-test": "cross-env-shell TEST_BUNDLE_ONLY=1 'npm run build'",
    "build:cjs": "babel-config-cjs -d ./cjs ./src",
    "build:es": "babel-config-es -d ./es ./src",
    "build:js": "rollup -c scripts/rollup.config.js",
    "clean": "shx rm -rf ./dist ./test/dist ./cjs ./es && shx mkdir -p ./dist ./test/dist ./cjs ./es",
    "lint": "vjsstandard",
    "server": "karma start scripts/karma.conf.js --singleRun=false --auto-watch",
    "start": "npm-run-all -p server watch",
    "test": "npm-run-all lint build-test && karma start scripts/karma.conf.js",
    "posttest": "shx cat test/dist/coverage/text.txt",
    "preversion": "npm test",
    "watch": "npm-run-all -p watch:*",
    "watch:cjs": "npm run build:cjs -- -w",
    "watch:es": "npm run build:es -- -w",
    "watch:js": "npm run build:js -- -w",
    "prepublishOnly": "npm-run-all build-prod && vjsverify --verbose --skip-syntax"
  },
  "keywords": [
    "videojs",
    "videojs-plugin"
  ],
  "author": "Adam Oliver <mail@adamoliver.net>",
  "license": "MIT",
  "style": "dist/videojs-analytics.css",
  "videojs-plugin": {
    "style": "dist/videojs-analytics.css",
    "script": "dist/videojs-analytics.min.js"
  },
  "vjsstandard": {
    "ignore": [
      "es",
      "es5",
      "cjs",
      "dist",
      "docs",
      "test/dist"
    ]
  },
  "files": [
    "CONTRIBUTING.md",
    "cjs/",
    "dist/",
    "docs/",
    "es/",
    "index.html",
    "scripts/",
    "src/",
    "test/"
  ],
  "dependencies": {
    "global": "^4.4.0"
  },
  "peerDependencies": {
    "video.js": "^8.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.13.16",
    "@babel/core": "^7.14.0",
    "@babel/runtime": "^7.14.0",
    "@videojs/babel-config": "^1.0.2",
    "@videojs/generator-helpers": "~2.0.2",
    "karma": "^6.3.2",
    "qunit": "^2.19.0",
    "rollup": "^2.46.0",
    "sinon": "^15.0.0",
    "video.js": "^8.0.0",
    "videojs-generate-karma-config": "~8.0.0",
    "videojs-generate-rollup-config": "~7.0.0",
    "videojs-generator-verify": "~4.0.0",
    "videojs-standard": "^9.0.0"
  },
  "engines": {
    "node": ">=16",
    "npm": ">=8"
  }
}
